# Python environment — uv sync creates a ~326 MB venv here
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Deployment config generated by `agentcore configure`.
# Contains the AWS account ID, runtime ID and execution-role ARN — account-specific
# and not part of the submission checklist. setup_permissions.py reads it locally.
.bedrock_agentcore.yaml
Dockerfile
.dockerignore

# Build cache written by `agentcore launch`. dependencies.zip is ~102 MB, which
# exceeds GitHub's hard 100 MB per-file limit and will reject the push outright.
# Regenerated on every launch; never part of the submission.
.bedrock_agentcore/

# Credentials — never commit. The AgentCore CLI reads key values from the
# environment and pushes them to AgentCore Identity on deploy.
.env
.env.*
*.pem

# Working notes: contains computed test answers, local machine paths, and a
# step map of the project. Public repo + graded coursework = keep this local.
PROJECT_NOTES.md

# Editor config — pins AWS_PROFILE=default for integrated terminals and points
# Pylance at starter/.venv. Machine-specific; not part of the submission.
.vscode/

# Local test scratch
/tmp/
*.local.json

# macOS
.DS_Store
